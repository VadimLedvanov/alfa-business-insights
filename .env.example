POSTGRES_DB=alfadb
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=alfa_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/alfadb
SERVER_PORT=8080

# Сервисы внутри Docker Compose
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_MIN_SCORE=0.65
ML_URL=http://ml:8000
LLM_API_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=

# Модели по задачам
ML_FACTS_MODEL=google/gemma-4-26b-a4b
ML_EMBEDDER=intfloat/multilingual-e5-small
LLM_INSIGHTS_MODEL=z-ai/glm-5.3-flash
LLM_FOLLOW_UP_MODEL=qwen3.6-35b-a3b
LLM_RANKING_MODEL=deepseek-v4.1-flash

# Spring AI (Java backend)
ML_STUB=false
SPRING_AI_MODEL_CHAT=openai
OPENAI_API_KEY=${LLM_API_KEY}
SPRING_AI_OPENAI_BASEURL=${LLM_API_URL}
SPRING_AI_OPENAI_CHAT_MODEL=${LLM_INSIGHTS_MODEL}

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev
KC_HOSTNAME=http://localhost/auth
KEYCLOAK_ISSUER_URI=http://localhost/auth/realms/alfa-business-insights
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/alfa-business-insights/protocol/openid-connect/certs
