POSTGRES_DB=alfadb
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=alfa_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/alfadb
SERVER_PORT=8080

# Keycloak (локальный запуск)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev
KC_HOSTNAME=http://localhost:8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/alfa-business-insights
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/alfa-business-insights/protocol/openid-connect/certs
