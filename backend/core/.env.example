# Переменные нужно экспортировать в окружение процесса; Spring Boot не читает .env автоматически.
ML_STUB=true
# openai — реальная модель через автоконфигурацию Spring AI.
SPRING_AI_MODEL_CHAT=openai
OPENAI_API_KEY=
SPRING_AI_OPENAI_BASEURL=https://changellenge.up.railway.app/v1
SPRING_AI_OPENAI_CHAT_MODEL=z-ai/glm-5.3-flash
# Запасной адрес: https://api.alfahack-gateway26.ru/v1
